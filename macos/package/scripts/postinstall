#!/bin/bash
# The .pkg's postinstall, run by Installer as root once the payload is in place (in /Library/Application Support/Immich/
# pkg/<release>): hands the release and the models to the user who is logged in, then configures and starts Immich for
# them with the release's configure.sh, as install.sh does. A Homebrew-based (install.sh) install of theirs is taken
# over: its database, settings and library are kept.
#
# Its output is in /var/log/install.log; configure.sh's also in ~/Library/Logs/Immich/install.log.
set -euo pipefail

RELEASE_ID="@RELEASE_ID@"
STAGE="/Library/Application Support/Immich/pkg"
PAYLOAD="$STAGE/$RELEASE_ID"
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

log() { echo "immich postinstall: $*"; }
log "started: $RELEASE_ID"
# what failed, if anything does: Installer shows only that the script did
trap 'log "failed at line $LINENO (exit $?)"' ERR
cleanup() {
  rm -rf "$PAYLOAD"
  rmdir "$STAGE" "/Library/Application Support/Immich" 2>/dev/null || true
}
trap cleanup EXIT

# Immich runs as LaunchAgents of a user logged in to a desktop session, which they need. Which user: the one who opened
# Installer; or, from the command line (sudo installer), the one at the screen. The screen alone is not enough: in a
# remote session (Screen Sharing on a Mac mini without a display), it shows the login window.
is_user() {
  [ -n "$1" ] && [ "$1" != root ] && [ "$1" != loginwindow ] && [ "$1" != _mbsetupuser ] \
    && [ "$(id -u "$1" 2>/dev/null || echo 0)" -ge 500 ]
}
# The first user, not root, running COMMAND. awk reads all of ps' output rather than leaving at the first match: ps
# writes more than a pipe holds (hundreds of processes), and one left with more to write dies of SIGPIPE, which
# pipefail makes this script's failure, before it has logged anything (macos/verification/m4-pkg-postinstall-sigpipe.md).
# BEGIN first_user_running (macos/package/tests/postinstall-pipes.sh runs it)
first_user_running() {
  ps -axo user=,comm= | awk -v command="$1" '$2 == command && $1 != "root" && !found { print $1; found = 1 }'
}
# END first_user_running
installer_user="$(first_user_running /System/Library/CoreServices/Installer.app/Contents/MacOS/Installer)"
console_user="$(stat -f%Su /dev/console 2>/dev/null || true)"
log "Installer opened by: ${installer_user:-nobody}; at the screen: ${console_user:-nobody}; USER: ${USER:-unset}"
user=""
for candidate in "$installer_user" "$console_user" "${USER:-}"; do
  if is_user "$candidate"; then
    user="$candidate"
    break
  fi
done
if [ -z "$user" ]; then
  log "no user to install for: open the package while logged in as the user Immich is to run as"
  exit 1
fi
uid="$(id -u "$user")"
if ! launchctl print "gui/$uid" >/dev/null 2>&1; then
  log "$user is not logged in to a desktop session (only over SSH?): log in on the Mac, or through Screen Sharing, then install"
  exit 1
fi
group="$(id -gn "$user")"
home="$(dscl . -read "/Users/$user" NFSHomeDirectory | awk '{ print $2 }')"
immich_home="$home/Library/Application Support/Immich"
log "installing $RELEASE_ID for $user ($home)"

# as the user, in their login session: launchctl reaches their LaunchAgents only from there
as_user() {
  launchctl asuser "$uid" sudo -u "$user" -H env -i HOME="$home" USER="$user" LOGNAME="$user" SHELL=/bin/zsh \
    TMPDIR="$(sudo -u "$user" getconf DARWIN_USER_TEMP_DIR)" PATH="$PATH" LANG=en_US.UTF-8 "$@"
}

chown -R "$user:$group" "$PAYLOAD"

# The models, unless the user has them already (a takeover, or the same .pkg again): a rename, on the same volume.
# Each is the folder its marker is in: <task>/<name> for the older exports, <task>/<name>/<revision> for newer ones,
# which go beside an older export the user has, never over it (immichctl warm retires that once they are ready).
as_user mkdir -p "$immich_home/data/models"
while IFS= read -r -d '' marker; do
  model="$(dirname "$marker")"
  relative="${model#"$PAYLOAD/models/"}"
  target="$immich_home/data/models/$relative"
  if [ -e "$target/.immich-native-downloaded" ]; then
    log "model $relative: there already"
  else
    as_user rm -rf "$target"
    as_user mkdir -p "$(dirname "$target")"
    as_user mv "$model" "$target"
    log "model $relative: installed"
  fi
done < <(find "$PAYLOAD/models" -name .immich-native-downloaded -print0)

# Installer stops this script at 600 seconds, and preparing the models the first time takes longer: configure.sh sets
# that up as a LaunchAgent of the user's, which goes on after Installer closes (macos/verification/
# m4-pkg-postinstall-timeout.md). What follows it runs whether it succeeded or not.
status=0
started=$SECONDS
as_user "$PAYLOAD/release/native/configure.sh" --release "$PAYLOAD/release" --warm-in-background || status=$?
log "configure.sh: exit $status after $((SECONDS - started)) s"

# immichctl on every user's PATH: /usr/local/bin is on it from the first login, unlike ~/.local/bin
link=/usr/local/bin/immichctl
if [ -x "$immich_home/bin/immichctl" ] && { [ ! -e "$link" ] || [ "$(basename "$(readlink "$link")")" = immichctl ]; }; then
  mkdir -p /usr/local/bin
  ln -sfn "$immich_home/bin/immichctl" "$link"
fi

# the web UI, for creating the admin account
if [ "$status" -eq 0 ]; then
  port="$(sed -n 's/^IMMICH_NATIVE_SERVER_PORT=//p' "$immich_home/config/native.env")"
  as_user open "http://localhost:${port:-2283}" || true
fi
log "done"
exit "$status"
