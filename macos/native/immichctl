#!/bin/bash
# Controls a native Immich install: its four LaunchAgents (postgres, valkey, ml, server), logs, and host checks.
#
#   immichctl status                    state and health of every service
#   immichctl start|stop|restart [svc]  all services in dependency order, or one
#   immichctl logs [svc] [-f]           the last lines of one log, or of all; -f follows
#   immichctl admin <args>              the server's admin CLI, e.g. `immichctl admin reset-admin-password`
#   immichctl psql [args]               a psql session on the Immich database
#   immichctl warm [--background]       downloads and prepares the machine learning models the settings name;
#                                       --background in a one-off LaunchAgent (the .pkg's way), see: immichctl logs warm
#   immichctl clip-model [NAME]         shows, or switches, the smart search model; then prepares it
#   immichctl video-accel [videotoolbox|disabled]  shows, or switches, video transcoding on the GPU
#   immichctl doctor                    checks that the Mac keeps Immich running unattended
#   immichctl uninstall [--purge]       removes the services; --purge also unmounts network shares and deletes the
#                                       install (never the library)
#
# Services stopped with `stop` come back at the next login, since their LaunchAgents stay in ~/Library/LaunchAgents.
set -euo pipefail

# follows the ~/.local/bin link to the install's bin directory
self="$0"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in /*) self="$target" ;; *) self="$(dirname "$self")/$target" ;; esac
done
home="$(cd "$(dirname "$self")/.." && pwd)"
# shellcheck source=/dev/null
. "$home/config/native.env"

domain="gui/$(id -u)"
services=(postgres valkey ml server)
logs="$IMMICH_NATIVE_LOG_DIR"
# set while `warm` runs the service's warm-up, and while it holds the server to its API
warm_pid="" warm_holding=""
warm_flag="$home/run/warming"

label() { echo "$IMMICH_NATIVE_LABEL_PREFIX.$1"; }
plist() { echo "$HOME/Library/LaunchAgents/$(label "$1").plist"; }
is_loaded() { launchctl print "$domain/$(label "$1")" >/dev/null 2>&1; }
# Every pipeline here reads its input to the end: under pipefail, one whose reader stops early (awk's exit, grep -q,
# head) fails when the writer has more to write than the pipe holds (macos/verification/m4-pkg-postinstall-sigpipe.md)
job_pid() { launchctl print "$domain/$(label "$1")" 2>/dev/null | awk '$1 == "pid" && !found { print $3; found = 1 }'; }

# the release's own, for a self-contained release (the .pkg's), or Homebrew's
valkey_cli() {
  local cli="$home/current/valkey/bin/valkey-cli"
  [ -x "$cli" ] || cli=/opt/homebrew/bin/valkey-cli
  "$cli" "$@"
}

check_service() {
  case "$1" in
    postgres | valkey | ml | server) ;;
    *) echo "unknown service: $1 (one of: ${services[*]})" >&2; exit 64 ;;
  esac
}

healthy() {
  case "$1" in
    postgres) "$IMMICH_NATIVE_PG_PREFIX/bin/pg_isready" -q -h 127.0.0.1 -p "$IMMICH_NATIVE_DB_PORT" ;;
    valkey) [ "$(valkey_cli -p "$IMMICH_NATIVE_REDIS_PORT" ping 2>/dev/null)" = PONG ] ;;
    ml) [ "$(curl -fsS -m 2 "http://127.0.0.1:$IMMICH_NATIVE_ML_PORT/ping" 2>/dev/null)" = pong ] ;;
    server) curl -fsS -m 2 "http://127.0.0.1:$IMMICH_NATIVE_SERVER_PORT/api/server/ping" 2>/dev/null | grep pong >/dev/null ;;
  esac
}

# the first start runs every database migration, and ml may be compiling CoreML models
wait_healthy() {
  local service="$1" timeout="${2:-180}" waited=0
  until healthy "$service"; do
    if [ "$waited" -ge "$timeout" ]; then
      echo "  $service is not healthy after ${timeout}s, see: immichctl logs $service" >&2
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
}

start_one() {
  local service="$1"
  if is_loaded "$service"; then
    launchctl kickstart "$domain/$(label "$service")"
  else
    launchctl bootstrap "$domain" "$(plist "$service")"
  fi
  wait_healthy "$service" && echo "  $service: running"
}

stop_one() {
  local service="$1" pid group waited=0
  if ! is_loaded "$service"; then
    echo "  $service: not running"
    return 0
  fi
  pid="$(job_pid "$service")"
  group="$( [ -n "$pid" ] && ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
  launchctl bootout "$domain/$(label "$service")" 2>/dev/null || true
  while is_loaded "$service" || { [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; }; do
    [ "$waited" -ge 90 ] && { echo "  $service did not stop within 90s" >&2; return 1; }
    sleep 1
    waited=$((waited + 1))
  done
  # launchd ends the job's process group with it; anything left (the server's exiftool children, say) is reported
  if [ -n "$group" ] && pgrep -g "$group" >/dev/null 2>&1; then
    echo "  $service: processes left in group $group: $(pgrep -g "$group" | tr '\n' ' '), stopping them" >&2
    pkill -TERM -g "$group" 2>/dev/null || true
  fi
  echo "  $service: stopped"
}

reverse() {
  local i
  for ((i = $# ; i > 0 ; i--)); do echo "${!i}"; done
}

selected() {
  if [ $# -gt 0 ]; then
    check_service "$1"
    echo "$1"
  else
    printf '%s\n' "${services[@]}"
  fi
}

cmd_status() {
  local service pid state health release
  release="$(cd "$home/current" 2>/dev/null && pwd -P || echo none)"
  echo "install:  $home"
  echo "release:  $(basename "$release")"
  echo "library:  $IMMICH_NATIVE_LIBRARY"
  printf '\n%-9s %-22s %s\n' service state health
  for service in "${services[@]}"; do
    if ! is_loaded "$service"; then
      state="not loaded"
    else
      pid="$(job_pid "$service")"
      state="${pid:+running, pid $pid}"
      state="${state:-loaded, not running}"
    fi
    healthy "$service" && health=ok || health="-"
    printf '%-9s %-22s %s\n' "$service" "$state" "$health"
  done
  if warming; then
    echo "models:   being prepared; until then smart search, faces and text wait in the queue (immichctl logs warm)"
  elif [ -f "$(plist warm)" ]; then
    echo "models:   preparing them in the background failed: see immichctl logs warm; immichctl warm tries again"
  fi
  echo
  if [ -n "${IMMICH_NATIVE_LISTEN:-}" ]; then
    echo "web:      http://$IMMICH_NATIVE_LISTEN:$IMMICH_NATIVE_SERVER_PORT"
  else
    echo "web:      http://$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo localhost):$IMMICH_NATIVE_SERVER_PORT"
  fi
}

cmd_logs() {
  local follow="" lines=50 service="" files=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -f) follow=1 ;;
      -n) lines="$2"; shift ;;
      warm) service=warm ;;
      *) check_service "$1"; service="$1" ;;
    esac
    shift
  done
  if [ "$service" = warm ]; then
    files=("$logs/warm.log" "$logs/ml-warm.log")
  elif [ -n "$service" ]; then
    files=("$logs/$service.log")
  else
    for service in "${services[@]}"; do files+=("$logs/$service.log"); done
  fi
  tail -n "$lines" ${follow:+-F} "${files[@]}"
}

cmd_doctor() {
  local ok=0 warn=0 value
  pass() { printf '  [ OK ] %s\n' "$1"; ok=$((ok + 1)); }
  note() { printf '  [WARN] %s\n' "$1"; warn=$((warn + 1)); }

  echo "== Keeping Immich running unattended"
  value="$(pmset -g | awk '$1 == "sleep" && !found { print $2; found = 1 }')"
  [ "$value" = 0 ] && pass "system sleep is off" \
    || note "system sleep after ${value} min: System Settings > Energy > Prevent automatic sleeping (or: sudo pmset -a sleep 0)"
  value="$(pmset -g | awk '$1 == "autorestart" && !found { print $2; found = 1 }')"
  [ "$value" = 1 ] && pass "restarts after a power failure" \
    || note "does not restart after a power failure: System Settings > Energy > Start up automatically after a power failure (or: sudo pmset -a autorestart 1)"
  value="$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null || true)"
  if [ "$value" = "$(id -un)" ]; then
    pass "logs in automatically as $value, which starts the services after a restart"
  elif [ "$(fdesetup isactive 2>/dev/null)" = true ]; then
    note "FileVault is on, which rules out automatic login: after a restart Immich waits until someone logs in"
  else
    note "no automatic login as $(id -un): after a restart Immich waits until you log in (System Settings > Users & Groups > Automatically log in as)"
  fi

  echo "== Network"
  if /usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>/dev/null | grep enabled >/dev/null; then
    note "the firewall is on: allow incoming connections for node when macOS asks, or phones cannot reach port $IMMICH_NATIVE_SERVER_PORT"
  else
    pass "the firewall lets other devices reach port $IMMICH_NATIVE_SERVER_PORT"
  fi

  echo "== Library"
  if [ -d "$IMMICH_NATIVE_LIBRARY" ] && [ -w "$IMMICH_NATIVE_LIBRARY" ]; then
    value="$(df -g "$IMMICH_NATIVE_LIBRARY" | awk 'NR == 2 { print $4 }')"
    pass "$IMMICH_NATIVE_LIBRARY is writable, ${value} GB free"
  else
    note "$IMMICH_NATIVE_LIBRARY is missing or not writable (an external disk that is not mounted?)"
  fi

  echo
  echo "Result: $ok ok, $warn warnings"
}

# the network shares the server has mounted under the install (Administration > Network shares), one per line
share_mounts() {
  local mounts
  mounts="$(cd "$home" && pwd -P)/mounts/"
  /sbin/mount | sed -n 's/^.* on \(.*\) ([^()]*)$/\1/p' | while IFS= read -r path; do
    case "$path" in "$mounts"*) echo "$path" ;; esac
  done
}

# a NAS share mounted read-write under the install would be emptied by deleting the install
unmount_shares() {
  local path
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    /sbin/umount "$path" 2>/dev/null || /sbin/umount -f "$path" 2>/dev/null || true
  done < <(share_mounts)
  if [ -n "$(share_mounts)" ]; then
    echo "still mounted, unmount them first (umount -f <path>):" >&2
    share_mounts | sed 's/^/  /' >&2
    return 1
  fi
}

cmd_uninstall() {
  local purge="" service
  [ "${1:-}" = --purge ] && purge=1
  launchctl bootout "$domain/$(label warm)" 2>/dev/null || true
  rm -f "$(plist warm)" "$warm_flag"
  for service in $(reverse "${services[@]}"); do
    stop_one "$service"
    rm -f "$(plist "$service")"
  done
  echo "removed the LaunchAgents"
  if [ -n "$purge" ]; then
    unmount_shares || { echo "kept $home, as network shares are mounted in it" >&2; exit 1; }
    rm -rf "$home"
    echo "deleted $home"
  else
    echo "kept $home (database, settings, models); \`immichctl uninstall --purge\` deletes it"
  fi
  echo "kept the library: $IMMICH_NATIVE_LIBRARY"
  # what the .pkg added outside the install, which only an administrator can remove
  local link=/usr/local/bin/immichctl leftovers=()
  [ "$(readlink "$link" 2>/dev/null)" = "$home/bin/immichctl" ] && leftovers+=("sudo rm $link")
  pkgutil --pkg-info io.github.sincemetom.immich >/dev/null 2>&1 \
    && leftovers+=("sudo pkgutil --forget io.github.sincemetom.immich")
  if [ ${#leftovers[@]} -gt 0 ]; then
    echo "installed by the .pkg: to remove what it added outside the install, run"
    printf '  %s\n' "${leftovers[@]}"
  fi
}

# --- machine learning models -------------------------------------------------------------------------------------

db() {
  PGPASSWORD="$IMMICH_NATIVE_DB_PASSWORD" "$IMMICH_NATIVE_PG_PREFIX/bin/psql" -h 127.0.0.1 -p "$IMMICH_NATIVE_DB_PORT" \
    -U postgres -d immich -X -q -v ON_ERROR_STOP=1 "$@"
}

# the stored settings: what differs from the defaults, saved by the web UI (empty before the first start)
stored_config() {
  db -At -c "SELECT value FROM system_metadata WHERE key = 'system-config'" 2>/dev/null || true
}

# the server's own code answers, from the release that runs: the defaults merged with the stored settings
release_node() {
  local release script="$1"
  shift
  release="$(cd "$home/current" && pwd -P)"
  (cd "$release/server" && IMMICH_STORED_CONFIG="$(stored_config)" "$release/node/bin/node" --input-type=module \
    -e "const dist = '$release/server/dist'; $script" "$@")
}

# prints: CLIP model, face model, OCR model, OCR max resolution
ml_models() {
  release_node "
    const { defaults } = await import(dist + '/dtos/config.dto.js');
    const stored = JSON.parse(process.env.IMMICH_STORED_CONFIG || '{}').machineLearning ?? {};
    const pick = (section, key) => stored[section]?.[key] ?? defaults.machineLearning[section][key];
    console.log([pick('clip', 'modelName'), pick('facialRecognition', 'modelName'), pick('ocr', 'modelName'),
      pick('ocr', 'maxResolution')].join(' '));"
}

cmd_warm() {
  local clip face ocr ocr_max
  read -r clip face ocr ocr_max <<<"$(ml_models)"
  [ -n "$ocr_max" ] || { echo "cannot read the machine learning settings from the server's code" >&2; return 1; }
  echo "preparing the machine learning models:"
  echo "  smart search: $clip"
  echo "  faces:        $face"
  echo "  text (OCR):   $ocr (max resolution $ocr_max)"
  forget_compiled_old_exports "$clip" "$face" "$ocr"
  warm_begin
  # whatever ends this (an error, Ctrl-C, a stop), the warm-up stops and the services come back as they were
  trap 'warm_cleanup; warm_end' EXIT
  trap 'echo; echo "  stopped: run immichctl warm again to resume (a download continues where it left off)"; exit 130' INT TERM
  warm_once "$clip" "$face" "$ocr" "$ocr_max"
  # A model that does not load (an interrupted download) is deleted and fetched again, and with it everything
  # prepared in its folder, like the CLIP text half beside a broken image half. The preload does not go back to
  # what it already loaded, so one more pass prepares what was lost.
  if grep -q "Clearing cache" "$logs/ml-warm.log"; then
    echo "  a model had to be downloaded again, preparing once more"
    warm_once "$clip" "$face" "$ocr" "$ocr_max"
  fi
  retire_old_exports "$clip" "$face" "$ocr"
  warm_end
  trap - EXIT INT TERM
}

# whether a warm-up is preparing the models, as run-service tells (see there)
warming() {
  local holder
  holder="$(cat "$warm_flag" 2>/dev/null)" || return 1
  case "$holder" in
    agent) [ -f "$(plist warm)" ] ;;
    '' | *[!0-9]*) return 1 ;;
    *) kill -0 "$holder" 2>/dev/null ;;
  esac
}

# how the running server was started (run-service): `all`, or `warm-up` (its API alone), by a release before mac.6
server_workers() {
  cat "$home/run/server-workers" 2>/dev/null || echo all
}

# The server keeps running while the models are prepared: it sees the flag, and holds the jobs that call the machine
# learning service, which the warm-up replaces, until the flag is gone (QueueService); the rest go on. Nothing is
# restarted (macos/verification/m4-person-cover-during-warmup.md).
warm_begin() {
  mkdir -p "$home/run"
  echo $$ >"$warm_flag"
  warm_holding=1
  if is_loaded server; then
    echo "  the server runs meanwhile; smart search, faces and text wait until the models are ready"
  fi
}

# the jobs that waited go on, as the server finds the flag gone; a no-op once that is done
warm_end() {
  [ -n "$warm_holding" ] || return 0
  warm_holding=""
  # unless another warm-up is to follow, which set the flag (warm_schedule): it then holds the jobs
  [ "$(cat "$warm_flag" 2>/dev/null)" = $$ ] || return 0
  rm -f "$warm_flag"
  # a server a release before mac.6 started with its API alone gets its job worker back
  if is_loaded server && [ "$(server_workers)" = warm-up ]; then
    stop_one server >/dev/null
    start_one server >/dev/null || true
  fi
}

# --- the warm-up in the background: a one-off LaunchAgent ----------------------------------------------------------
# The .pkg's postinstall may take no more than 600 seconds, which Installer stops it at (macos/verification/
# m4-pkg-postinstall-timeout.md), and preparing the models the first time takes longer. So it sets the warm-up up as a
# LaunchAgent of the user's, which runs `immichctl warm` once and then removes itself: it goes on after Installer
# closes, and starts over at the next login if the Mac restarts first or it fails.

# sets it up: the LaunchAgent, not started, and the flag that has the server hold the jobs that need the models
warm_schedule() {
  local pid waited=0
  mkdir -p "$home/run" "$logs" "$(dirname "$(plist warm)")"
  # One still running (the .pkg opened again) stops, and this one starts over. Told by the flag that another follows,
  # it leaves the services as they are; launchctl returns before it has stopped, so this waits for it.
  if is_loaded warm; then
    pid="$(job_pid warm)"
    echo agent >"$warm_flag"
    launchctl bootout "$domain/$(label warm)" 2>/dev/null || true
    while is_loaded warm || { [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; }; do
      [ "$waited" -ge 120 ] && { echo "the warm-up running did not stop within 120 s" >&2; return 1; }
      sleep 1
      waited=$((waited + 1))
    done
    echo "  stopped the warm-up that was running, to start it over"
  fi
  cat >"$(plist warm)" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by immichctl warm --schedule: prepares the machine learning models once, then removes itself -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$(xml "$(label warm)")</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml "$home/bin/immichctl")</string>
    <string>warm</string>
    <string>--agent</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Standard</string>
  <key>ExitTimeOut</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>$(xml "$logs/warm.log")</string>
  <key>StandardErrorPath</key>
  <string>$(xml "$logs/warm.log")</string>
</dict>
</plist>
EOF
  plutil -lint -s "$(plist warm)"
  warming || echo agent >"$warm_flag"
}

# and starts it
warm_background() {
  warm_schedule
  launchctl bootstrap "$domain" "$(plist warm)"
  echo "preparing the machine learning models in the background (the first time, 10-15 minutes):"
  echo "  the web UI, the apps and thumbnails work meanwhile; smart search, faces and text wait in the queue"
  echo "  progress: immichctl logs warm; immichctl status says when it is done"
}

# what the LaunchAgent runs
warm_agent() {
  local child status=0
  echo "== $(date '+%F %T') preparing the machine learning models"
  # in a child, which a stop (launchd's SIGTERM) reaches through the trap: its own trap then stops the service's
  # warm-up, whose process group is its own, and brings the services back
  "$home/bin/immichctl" warm &
  child=$!
  trap 'kill -TERM "$child" 2>/dev/null; wait "$child"; exit 143' TERM INT
  wait "$child" || status=$?
  trap - TERM INT
  if [ "$status" -ne 0 ]; then
    echo "== $(date '+%F %T') failed ($status): tried again at the next login, or now with: immichctl warm"
    exit "$status"
  fi
  echo "== $(date '+%F %T') done"
  rm -f "$(plist warm)"
  # done for good: unloaded, which ends this too
  launchctl bootout "$domain/$(label warm)" 2>/dev/null || true
}

# escapes a value for a plist
xml() {
  local value="$1"
  value="${value//&/&amp;}"
  value="${value//</&lt;}"
  echo "${value//>/&gt;}"
}

# the revision of the models' exports the service runs (run-service), whose folder is <model>/<revision>, but for main
model_revision() {
  local revision
  revision="$("$home/bin/run-service" model-revision)"
  [ -n "$revision" ] || { echo "run-service names no revision of the models" >&2; return 1; }
  echo "$revision"
}

# the folder each of these models' current export is in, as task|folder|export folder
model_folders() {
  local revision task name dir
  revision="$(model_revision)" || return 1
  for pair in "clip|$1" "facial-recognition|$2" "ocr|$3"; do
    task="${pair%%|*}" name="${pair#*|}"
    dir="$home/data/models/$task/$name"
    if [ "$revision" = main ]; then echo "$task|$dir|$dir"; else echo "$task|$dir|$dir/$revision"; fi
  done
}

# Moving to another export of a model (main to v2), what CoreML specialized for the older one's graphs stays in its
# cache in ~/Library/Caches/python, keyed by paths no graph has any more: about 10 GB for the default models. Every
# graph of the new export is compiled anyway, so the cache goes before they are.
forget_compiled_old_exports() {
  local cache="$HOME/Library/Caches/python/com.apple.e5rt.e5bundlecache" moving="" task dir current older revision
  revision="$(model_revision)" || return 0
  [ "$revision" != main ] || return 0
  while IFS='|' read -r task dir current; do
    # an older export of it is here (main's halves in the model's own folder), and the new one not yet prepared
    older="$(find "$dir" -mindepth 1 -maxdepth 1 ! -name "$(basename "$current")" ! -name '.*' 2>/dev/null | sed -n 1,3p)"
    if [ -n "$older" ] && ! find "$current" -name manifest.json -path '*/coreml/*' -print -quit 2>/dev/null | grep -q .; then
      moving="$moving $(basename "$dir") ($(echo "$older" | xargs -I{} basename {} | tr '\n' ' ' | sed 's/ $//'))"
    fi
  done <<<"$(model_folders "$@")"
  if [ -n "$moving" ] && [ -d "$cache" ]; then
    echo "  older exports:$moving"
    echo "  clearing what CoreML compiled for them ($(du -sh "$cache" 2>/dev/null | cut -f1))"
    rm -rf "$cache"
  fi
}

# Once the current export of a model is ready, its older one, and all that was prepared from it, is of no more use:
# for the default models, moving from main to v2, about 20 GB
retire_old_exports() {
  local task dir current freed revision
  revision="$(model_revision)" || return 0
  [ "$revision" != main ] || return 0
  while IFS='|' read -r task dir current; do
    [ -f "$current/.immich-native-downloaded" ] || continue
    find "$current" -name manifest.json -path '*/coreml/*' -print -quit 2>/dev/null | grep -q . || continue
    if find "$dir" -mindepth 1 -maxdepth 1 ! -name "$(basename "$current")" -print -quit | grep -q .; then
      freed="$(du -sh "$dir" 2>/dev/null | cut -f1)"
      find "$dir" -mindepth 1 -maxdepth 1 ! -name "$(basename "$current")" -exec rm -rf {} +
      echo "  removed the older export of $(basename "$dir") ($task): $freed before, $(du -sh "$dir" | cut -f1) now"
    fi
    # A graph prepared for the CPU beside one for CoreML: the service runs a model on the CPU only when CoreML cannot
    # compile it, so this one is what a warm-up stopped part way left (warm_cleanup), or a failure since overcome. A
    # model CoreML never compiles (PP-OCRv5_server) has no CoreML graph, and keeps its CPU one.
    for part in "$current"/*/; do
      if [ -d "$part/cpu" ] && find "$part/coreml" -name manifest.json -print -quit 2>/dev/null | grep -q .; then
        freed="$(du -sh "$part/cpu" 2>/dev/null | cut -f1)"
        rm -rf "$part/cpu"
        echo "  removed a CPU copy of $(basename "$dir") $(basename "$part") left beside its CoreML one ($freed)"
      fi
    done
  done <<<"$(model_folders "$@")"
}

warm_once() {
  local clip="$1" face="$2" ocr="$3" ocr_max="$4" started next elapsed size last
  # the warm-up takes the service's port (the server holds the jobs that would call it meanwhile: warm_begin)
  stop_one ml >/dev/null
  # in a process group of its own, so that stopping it reaches the downloader and the service's preparing children
  /usr/bin/perl -e 'setpgrp(0, 0); exec @ARGV or die "exec: $!\n"' \
    "$home/bin/run-service" ml-warm "$clip" "$face" "$ocr" "$ocr_max" >"$logs/ml-warm.log" 2>&1 &
  warm_pid=$!

  started=$SECONDS
  next=$SECONDS
  while ! healthy ml; do
    if ! kill -0 "$warm_pid" 2>/dev/null; then
      echo "  the warm-up stopped before the models were ready, see $logs/ml-warm.log" >&2
      sed 's/\x1b\[[0-9;]*m//g' "$logs/ml-warm.log" | tail -n 15 >&2
      return 1
    fi
    elapsed=$((SECONDS - started))
    if [ "$SECONDS" -ge "$next" ]; then
      next=$((SECONDS + 15))
      size="$(du -sm "$home/data/models" 2>/dev/null | awk '{ printf "%.1f GB", $1 / 1024 }' || true)"
      # nothing matches until the service logs its first step, which grep reports by failing
      last="$(sed 's/\x1b\[[0-9;]*m//g' "$logs/ml-warm.log" \
        | grep -oE "(Downloading|Preparing|Preloading|Loading) [^/]*" | tail -n 1 | cut -c1-70 || true)"
      printf '  %3d:%02d  %s in the model folder  %s\n' $((elapsed / 60)) $((elapsed % 60)) "$size" "${last:-starting}"
    fi
    sleep 1
  done
  elapsed=$((SECONDS - started))
  echo "  ready after $((elapsed / 60)) min $((elapsed % 60)) s, $(du -sm "$home/data/models" | awk '{ printf "%.1f GB", $1 / 1024 }') of models"
  warm_cleanup
}

# stops the service's warm-up and starts the service; a no-op once that is done
warm_cleanup() {
  [ -n "${warm_pid:-}" ] || return 0
  local pid="$warm_pid" waited=0
  warm_pid=""
  if healthy ml; then
    kill -TERM -- "-$pid" 2>/dev/null || true
  else
    # Stopped before it was done: all of it at once. Ended one by one, the child preparing a graph for CoreML dies
    # first, which the service takes for a graph CoreML cannot run, and it prepares one for the CPU (GBs) before it
    # ends too. What a child left half done is redone, as only a complete graph has its manifest (prepare.py).
    kill -KILL -- "-$pid" 2>/dev/null || true
  fi
  # while it downloads, the service is still starting up and does not act on SIGTERM
  while kill -0 -- "-$pid" 2>/dev/null; do
    [ "$waited" -ge 10 ] && { kill -KILL -- "-$pid" 2>/dev/null || true; break; }
    sleep 1
    waited=$((waited + 1))
  done
  wait "$pid" 2>/dev/null || true
  # not for another warm-up to follow (warm_schedule), which takes the port again
  [ "$(cat "$warm_flag" 2>/dev/null)" = agent ] || start_one ml || true
}

cmd_clip_model() {
  local current model="${1:-}" known stored
  read -r current _ <<<"$(ml_models)"
  if [ -z "$model" ]; then
    echo "$current"
    return
  fi
  known="$(release_node "const { CLIP_MODEL_INFO } = await import(dist + '/constants.js');
    console.log(process.argv[1] in CLIP_MODEL_INFO ? 'yes' : 'no')" "$model")"
  if [ "$known" != yes ]; then
    echo "unknown smart search model: $model (the ones Immich knows are in server/src/constants.ts, CLIP_MODEL_INFO)" >&2
    return 64
  fi
  settings_writable || return 1
  if [ "$model" = "$current" ]; then
    echo "smart search already uses $model"
  else
    # merged into the stored settings, as saving it in Settings > Machine Learning > Smart Search does
    db -v model="$model" <<'SQL'
INSERT INTO system_metadata (key, value)
VALUES ('system-config', jsonb_build_object('machineLearning', jsonb_build_object('clip', jsonb_build_object('modelName', :'model'))))
ON CONFLICT (key) DO UPDATE SET value = system_metadata.value || jsonb_build_object('machineLearning',
  coalesce(system_metadata.value -> 'machineLearning', '{}'::jsonb) || jsonb_build_object('clip',
    coalesce(system_metadata.value -> 'machineLearning' -> 'clip', '{}'::jsonb) || jsonb_build_object('modelName', :'model')));
SQL
    stored="$(stored_config)"
    case "$stored" in *"\"$model\""*) ;; *) echo "the setting did not take: $stored" >&2; return 1 ;; esac
    echo "smart search: $current -> $model"
  fi
  # the warm-up restarts the server, which then sizes the search index for the model's vectors
  [ "${2:-}" = --no-warm ] || cmd_warm
  if [ "$model" != "$current" ] && [ "$(db -At -c "SELECT count(*) FROM asset WHERE \"deletedAt\" IS NULL")" -gt 0 ]; then
    cat <<EOF

The photos already in the library were indexed with $current, whose search data no longer applies.
Re-index them in the web UI: Administration > Jobs > Smart Search > All.
EOF
  fi
}

# whether this script can change the settings, which the web UI otherwise keeps in the database
settings_writable() {
  if grep -qE '^[[:space:]]*IMMICH_CONFIG_FILE=' "$home/config/server.env" 2>/dev/null; then
    echo "server.env sets IMMICH_CONFIG_FILE, so the settings come from that file: change them there" >&2
    return 1
  fi
  if [ -z "$(db -At -c "SELECT to_regclass('system_metadata')")" ]; then
    echo "the database has no tables yet: start the server once (immichctl start), then run this again" >&2
    return 1
  fi
}

cmd_video_accel() {
  local current accel="${1:-}" stored concurrency
  current="$(release_node "
    const { defaults } = await import(dist + '/dtos/config.dto.js');
    console.log(JSON.parse(process.env.IMMICH_STORED_CONFIG || '{}').ffmpeg?.accel ?? defaults.ffmpeg.accel);")"
  if [ -z "$accel" ]; then
    echo "$current"
    return
  fi
  case "$accel" in
    videotoolbox | disabled) ;;
    *) echo "unknown video acceleration: $accel (videotoolbox or disabled; the others need hardware a Mac lacks)" >&2; return 64 ;;
  esac
  settings_writable || return 1
  if [ "$accel" != "$current" ]; then
    # merged into the stored settings, as saving it in Settings > Video Transcoding > Hardware Acceleration does
    db -v accel="$accel" <<'SQL'
INSERT INTO system_metadata (key, value)
VALUES ('system-config', jsonb_build_object('ffmpeg', jsonb_build_object('accel', :'accel')))
ON CONFLICT (key) DO UPDATE SET value = system_metadata.value || jsonb_build_object('ffmpeg',
  coalesce(system_metadata.value -> 'ffmpeg', '{}'::jsonb) || jsonb_build_object('accel', :'accel'));
SQL
    stored="$(stored_config)"
    case "$stored" in *"\"accel\": \"$accel\""*) ;; *) echo "the setting did not take: $stored" >&2; return 1 ;; esac
    echo "video transcoding: $current -> $accel"
  else
    echo "video transcoding already uses: $accel"
  fi
  # One transcode leaves Apple's media engine half idle: two together run twice as fast, about what the whole CPU
  # manages (macos/verification/m2-videotoolbox.md). Set unless the web UI's Jobs settings chose a number.
  concurrency=""
  if [ "$accel" = videotoolbox ]; then
    concurrency="$(db -At <<'SQL'
UPDATE system_metadata SET value = value || jsonb_build_object('job', coalesce(value -> 'job', '{}'::jsonb)
  || jsonb_build_object('videoConversion', jsonb_build_object('concurrency', 2)))
WHERE key = 'system-config' AND value #> '{job,videoConversion,concurrency}' IS NULL
RETURNING 2;
SQL
)"
    echo "video transcodes at once: $(db -At -c "SELECT coalesce(value #>> '{job,videoConversion,concurrency}', '1') FROM system_metadata WHERE key = 'system-config'")"
  fi
  [ "$accel" != "$current" ] || [ -n "$concurrency" ] || return 0
  # the server reads its settings when it starts
  if is_loaded server; then
    stop_one server >/dev/null
    start_one server
  fi
}

command="${1:-status}"
[ $# -gt 0 ] && shift
# service names have no spaces, so the word splitting of $(selected) is the list itself
# shellcheck disable=SC2046
case "$command" in
  status) cmd_status ;;
  start) for service in $(selected "$@"); do start_one "$service"; done ;;
  stop) for service in $(reverse $(selected "$@")); do stop_one "$service"; done ;;
  restart)
    for service in $(reverse $(selected "$@")); do stop_one "$service"; done
    for service in $(selected "$@"); do start_one "$service"; done
    ;;
  logs) cmd_logs "$@" ;;
  admin) exec "$home/bin/run-service" server immich-admin "$@" ;;
  psql)
    export PGPASSWORD="$IMMICH_NATIVE_DB_PASSWORD"
    exec "$IMMICH_NATIVE_PG_PREFIX/bin/psql" -h 127.0.0.1 -p "$IMMICH_NATIVE_DB_PORT" -U postgres -d immich "$@"
    ;;
  doctor) cmd_doctor ;;
  warm)
    case "${1:-}" in
      '') cmd_warm ;;
      --background) warm_background ;;
      --schedule) warm_schedule ;;  # configure.sh, before it starts the services
      --agent) warm_agent ;;
      *) echo "unknown option: $1 (immichctl warm [--background])" >&2; exit 64 ;;
    esac
    ;;
  clip-model) cmd_clip_model "$@" ;;
  video-accel) cmd_video_accel "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  -h | --help | help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "unknown command: $command (see immichctl help)" >&2; exit 64 ;;
esac
